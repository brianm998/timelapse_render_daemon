<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.timelapserender.trd</string>
  <key>ProgramArguments</key>
  <array><string>/Applications/Timelapse Render Daemon.app/Contents/MacOS/trd</string><string>daemon</string><string>--config</string><string>/Users/example/Library/Application Support/trd/config.json</string></array>
  <key>AssociatedBundleIdentifiers</key><string>com.timelapserender.trd</string>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Standard</string>
  <key>AbandonProcessGroup</key><true/>
</dict>
</plist>
