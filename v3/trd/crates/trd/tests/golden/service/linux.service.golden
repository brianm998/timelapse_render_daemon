[Unit]
Description=Timelapse Render Daemon
[Service]
ExecStart=/usr/lib/trd/trd daemon --config /home/example/.config/trd/config.json
Restart=on-failure
RestartSec=10
KillMode=process
[Install]
WantedBy=default.target
